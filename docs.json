{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Cybersecurity",
  "favicon": "/favicon.svg",
  "logo": {
    "dark": "/logo/dark.svg",
    "light": "/logo/light.svg"
  },
  "colors": {
    "primary": "#1E40AF",
    "light": "#3B82F6",
    "dark": "#1E3A8A"
  },
  "theme": "mint",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/richard-wollyce/cybersecurity"
        }
      ]
    },
    "languages": [
      {
        "language": "en",
        "default": true,
        "groups": [
          {
            "group": "Essentials",
            "pages": [
              "essentials/welcome",
              "essentials/threats-and-attacks",
              "essentials/password-security",
              "essentials/safe-browsing",
              "essentials/device-hygiene",
              "essentials/what-to-do-if-hacked"
            ]
          },
          {
            "group": "Advanced Topics",
            "pages": [
              "advanced/network-security",
              "advanced/cryptography",
              "advanced/web-vulnerabilities",
              "advanced/secure-coding-practices",
              "advanced/penetration-testing",
              "advanced/cypherpunks"
            ]
          }
        ]
      },
      {
        "language": "pt-BR",
        "groups": [
          {
            "group": "Fundamentos",
            "pages": [
              "pt-br/essentials/welcome",
              "pt-br/essentials/threats-and-attacks",
              "pt-br/essentials/password-security",
              "pt-br/essentials/safe-browsing",
              "pt-br/essentials/device-hygiene",
              "pt-br/essentials/what-to-do-if-hacked"
            ]
          },
          {
            "group": "Tópicos Avançados",
            "pages": [
              "pt-br/advanced/network-security",
              "pt-br/advanced/cryptography",
              "pt-br/advanced/web-vulnerabilities",
              "pt-br/advanced/secure-coding-practices",
              "pt-br/advanced/penetration-testing",
              "pt-br/advanced/cypherpunks"
            ]
          }
        ]
      }
    ]
  }
}